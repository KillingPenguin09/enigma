#!/usr/bin/env bash

VERBOSE=false

BIN_DIR="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
if [ -z "$ENIGMA_DIR" ]; then
    export ENIGMA_DIR="$(dirname "$BIN_DIR")/src"
fi

source "$ENIGMA_DIR/scripts/caching.sh"
source "$ENIGMA_DIR/scripts/config.sh"
source "$ENIGMA_DIR/scripts/i18n.sh"

if [ -z "$MAIN_QML" ]; then
    export MAIN_QML="$(find "$ENIGMA_DIR/quickshell" -type f \( -name "Shell.qml" -o -name "Bar.qml" \) 2>/dev/null | head -n 1)"
fi

is_alive() {
    local pid="$1"
    [ -n "$pid" ] || return 1
    kill -0 "$pid" 2>/dev/null || return 1
    if [ -d /proc ]; then
        if [ ! -f "/proc/$pid/status" ]; then
            return 1
        fi
        if grep -q '^State:[[:space:]]*Z' "/proc/$pid/status" 2>/dev/null; then
            return 1
        fi
        return 0
    fi
    return 0
}

terminate_and_wait() {
    local pid="$1"
    local timeout="${2:-2}"
    local count=0
    local max_count=$(( timeout * 10 ))

    if [ -z "$pid" ] || ! is_alive "$pid"; then
        return 0
    fi

    kill -TERM "$pid" 2>/dev/null

    while is_alive "$pid"; do
        sleep 0.1
        ((count++))
        if [ "$count" -ge "$max_count" ]; then
            kill -KILL "$pid" 2>/dev/null
            break
        fi
    done

    while is_alive "$pid" && [ "$count" -lt $(( max_count + 5 )) ]; do
        sleep 0.1
        ((count++))
    done
}

get_all_children() {
    local target="$1"
    local child
    for child in $(pgrep -P "$target" 2>/dev/null); do
        get_all_children "$child"
        echo "$child"
    done
}

get_installed_version() {
    local version_file="${XDG_STATE_HOME:-$HOME/.local/state}/enigma/version"
    local ver=""
    if [ -f "$version_file" ]; then
        ver=$(awk -F= '/^ENIGMA_VERSION=/{gsub(/["'\'' ]/, "", $2); print $2}' "$version_file")
    fi
    if [ -z "$ver" ] && [ -n "$ENIGMA_VERSION" ]; then
        ver="$ENIGMA_VERSION"
    fi
    if [ -z "$ver" ]; then
        if [ -n "$ENIGMA_DIR" ] && [ -f "$ENIGMA_DIR/version.txt" ]; then
            ver=$(cat "$ENIGMA_DIR/version.txt" 2>/dev/null | xargs)
        elif [ -f "$(dirname "$BIN_DIR")/version.txt" ]; then
            ver=$(cat "$(dirname "$BIN_DIR")/version.txt" 2>/dev/null | xargs)
        elif [ -n "$ENIGMA_DIR" ] && [ -f "$(dirname "$ENIGMA_DIR")/version.txt" ]; then
            ver=$(cat "$(dirname "$ENIGMA_DIR")/version.txt" 2>/dev/null | xargs)
        fi
    fi
    if [ -z "$ver" ]; then
        ver="2.0.0"
    fi
    echo "$ver"
}

show_help() {
    echo "$(t "daemon.cli.usage")"
    echo ""
    echo "$(t "daemon.cli.description")"
    echo ""
    echo "$(t "daemon.cli.commands")"
    echo "  start                       $(t "daemon.cli.cmd_start")"
    echo "  stop                        $(t "daemon.cli.cmd_stop")"
    echo "  status                      $(t "daemon.cli.cmd_status")"
    echo ""
    echo "$(t "daemon.cli.options")"
    echo "  -v, --verbose               $(t "daemon.cli.opt_verbose")"
    echo "  -V, --version               $(t "daemon.cli.opt_version")"
    echo "  -h, --help                  $(t "daemon.cli.opt_help")"
    echo ""
}

COMMAND=""
while [ $# -gt 0 ]; do
    case "$1" in
        -v|--verbose)
            VERBOSE=true
            export ENIGMA_VERBOSE=true
            shift
            ;;
        -V|--version)
            echo "enigmad v$(get_installed_version)"
            exit 0
            ;;
        -h|--help)
            show_help
            exit 0
            ;;
        start|stop|status)
            if [ -z "$COMMAND" ]; then
                COMMAND="$1"
            fi
            shift
            ;;
        *)
            echo "$(t "daemon.cli.unknown_arg" ARG="$1")"
            show_help
            exit 1
            ;;
    esac
done

if [ -z "$COMMAND" ]; then
    COMMAND="start"
fi

if [ "$COMMAND" == "stop" ]; then
    pid=""
    if [ -f "/tmp/enigmad.pid" ]; then
        pid="$(cat "/tmp/enigmad.pid" 2>/dev/null)"
    fi

    pkill -TERM -f "focus_daemon.py" 2>/dev/null
    if [ -n "$MAIN_QML" ]; then
        pkill -TERM -f "quickshell.*$MAIN_QML" 2>/dev/null
    fi

    if [ -n "$pid" ] && is_alive "$pid"; then
        terminate_and_wait "$pid" 2
    else
        pkill -TERM -f "enigmad" 2>/dev/null
        sleep 0.2
        pkill -KILL -f "enigmad" 2>/dev/null
    fi

    pkill -KILL -f "focus_daemon.py" 2>/dev/null
    if [ -n "$MAIN_QML" ]; then
        pkill -KILL -f "quickshell.*$MAIN_QML" 2>/dev/null
    fi

    rm -f "/tmp/enigmad.pid" 2>/dev/null
    rm -f "/tmp/enigmad.lock" 2>/dev/null
    echo "$(t "daemon.cli.stopped")"
    exit 0
fi

if [ "$COMMAND" == "status" ]; then
    pid=""
    if [ -f "/tmp/enigmad.pid" ]; then
        pid="$(cat "/tmp/enigmad.pid" 2>/dev/null)"
    fi
    if [ -n "$pid" ] && is_alive "$pid"; then
        echo "$(t "daemon.cli.status_running" PID="$pid")"
        exit 0
    else
        echo "$(t "daemon.cli.status_stopped")"
        exit 1
    fi
fi

if [ "$COMMAND" == "start" ]; then
    exec 9>"/tmp/enigmad.lock"

    if ! flock -n 9; then
        existing_pid=""
        [ -f "/tmp/enigmad.pid" ] && existing_pid="$(cat "/tmp/enigmad.pid" 2>/dev/null)"

        if [ -n "$existing_pid" ] && is_alive "$existing_pid"; then
            echo "$(t "daemon.already_running")"
            exit 1
        fi

        pkill -KILL -f "focus_daemon.py" 2>/dev/null
        if [ -n "$MAIN_QML" ]; then
            pkill -KILL -f "quickshell.*$MAIN_QML" 2>/dev/null
        fi
        sleep 0.2

        if ! flock -n 9; then
            echo "$(t "daemon.already_running")"
            exit 1
        fi
    fi

    echo $$ > "/tmp/enigmad.pid"

    CLEANUP_DONE=false
    LAUNCH_PID=""
    QS_PID=""

    cleanup() {
        if [ "$CLEANUP_DONE" = true ]; then
            return
        fi
        CLEANUP_DONE=true
        trap '' SIGINT SIGTERM SIGHUP

        [ "$VERBOSE" = true ] && echo "$(t "daemon.shutting_down")"

        local targets=()
        [ -n "$QS_PID" ] && targets+=("$QS_PID")
        [ -n "$LAUNCH_PID" ] && targets+=("$LAUNCH_PID")

        local child
        for child in $(get_all_children $$ 2>/dev/null); do
            targets+=("$child")
        done

        local focus_pid
        for focus_pid in $(pgrep -f "focus_daemon.py" 2>/dev/null); do
            targets+=("$focus_pid")
        done

        if [ -n "$MAIN_QML" ]; then
            local qs_extra
            for qs_extra in $(pgrep -f "quickshell.*$MAIN_QML" 2>/dev/null); do
                targets+=("$qs_extra")
            done
        fi

        local unique_targets=()
        if [ ${#targets[@]} -gt 0 ]; then
            unique_targets=($(printf "%s\n" "${targets[@]}" 2>/dev/null | sort -u))
        fi

        local p
        for p in "${unique_targets[@]}"; do
            if [ -n "$p" ] && [ "$p" != "$$" ] && is_alive "$p"; then
                kill -TERM "$p" 2>/dev/null
            fi
        done

        local count=0
        while [ "$count" -lt 10 ]; do
            local still_alive=false
            for p in "${unique_targets[@]}"; do
                if [ -n "$p" ] && [ "$p" != "$$" ] && is_alive "$p"; then
                    still_alive=true
                    break
                fi
            done
            if [ "$still_alive" = false ]; then
                break
            fi
            sleep 0.1
            ((count++))
        done

        for p in "${unique_targets[@]}"; do
            if [ -n "$p" ] && [ "$p" != "$$" ] && is_alive "$p"; then
                kill -KILL "$p" 2>/dev/null
            fi
        done

        exec 9>&- 2>/dev/null
        rm -f "/tmp/enigmad.pid" 2>/dev/null
        rm -f "/tmp/enigmad.lock" 2>/dev/null
        exit 0
    }

    trap cleanup SIGINT SIGTERM SIGHUP EXIT

    [ "$VERBOSE" = true ] && echo "$(t "daemon.launching")"

    bash "$ENIGMA_DIR/quickshell/guide/wellbeing/launch_daemon.sh" 9>&- &
    LAUNCH_PID=$!

    quickshell -p "$MAIN_QML" 9>&- &
    QS_PID=$!

    wait $QS_PID
fi
